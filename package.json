{
  "name": "alexandra-braginskaya-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "previews": "node scripts/generate-previews.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.yaml README.md public/image-cache-worker.js",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html *.yaml README.md public/image-cache-worker.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "packageManager": "pnpm@11.25.0"
}
